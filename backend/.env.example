# Supabase PostgreSQL Session Pooler URL (Port 5432)
# NOTE: Must use Session pooler (port 5432, username postgres.<ref>), not IPv6-only direct host
DATABASE_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:5432/postgres"

# Server Port
PORT=8080

# Environment mode (development / production)
NODE_ENV=development

# Allowed frontend origin(s) for CORS (comma-separated)
FRONTEND_URL="http://localhost:5173,https://your-frontend.vercel.app"
